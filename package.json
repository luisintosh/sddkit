{
  "name": "sddkit",
  "private": true,
  "type": "module",
  "description": "Spec-driven development harness for OpenCode and Cursor — prompts, transpile, sddkit-state CLI.",
  "scripts": {
    "test": "bun test src/state/",
    "transpile": "bun tools/transpile.ts",
    "build:cli": "bun tools/build-cli.ts",
    "gen-manifest": "bun tools/gen-manifest.ts",
    "build": "bun tools/transpile.ts && bun tools/build-cli.ts && bun tools/gen-manifest.ts",
    "check": "bun tools/check.ts",
    "lint": "biome lint .",
    "lint:fix": "biome lint --write .",
    "format": "prettier --write ."
  },
  "dependencies": {
    "yaml": "^2.9.0",
    "zod": "^4.1.8"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.6",
    "prettier": "^3.9.6"
  }
}
