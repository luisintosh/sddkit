{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode-go/glm-5.2",
  "small_model": "opencode-go/deepseek-v4-flash",
  "default_agent": "sdd",
  "instructions": ["AGENTS.md"],

  "command": {
    "setup-docs": {
      "description": "Scaffold project docs required for the AI working context.",
      "template": "Set up the project's AI working context.\n\nCreate missing files only; never overwrite existing files unless the user explicitly asks to refresh.\n\nInspect the repository enough to infer project name, purpose, stack, commands, conventions, architecture, and durable constraints.\n\nCreate:\n- AGENTS.md: concise always-loaded AI instructions with project commands, conventions, and links to docs/ARCHITECTURE.md and docs/CONSTITUTION.md.\n- docs/ARCHITECTURE.md: concise system overview, module map, data flow, key decisions, dependencies, and testing strategy.\n- docs/CONSTITUTION.md: concise governing principles for implementation and review.\n- docs/feats/.gitkeep: ensure feature artifact directory exists.\n\nAGENTS.md must include install/dev/build/test/lint/typecheck commands, using n/a when unknown.\n\nReturn a compact summary: created, skipped, inferred commands, and unknowns.",
    },
  },

  "lsp": true,
  "formatter": true,
  "permission": {
    "edit": "allow",
    "read": "allow",
    "webfetch": "allow",
    "bash": {
      "*": "allow",
      "rm -rf *": "deny",
      "rm -fr *": "deny",
      "rm -r *": "ask",
      "git clean *": "ask",
      "git reset --hard*": "deny",
      "git checkout -- *": "ask",
      "git restore *": "ask",
      "git push --force*": "deny",
      "git push -f *": "deny",
      "gh pr merge *": "ask",
      "sudo *": "ask",
      "chmod -R *": "ask",
      "chown -R *": "ask",
      "* | sh": "deny",
      "* | bash": "deny",
      "curl * | *": "deny",
      "wget * | *": "deny",
    },
  },
}
